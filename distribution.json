{
  "schema_version": 1,
  "name": "skill-builder",
  "profiles": {
    "runtime": {
      "include": [
        "SKILL.md", "README.md", "distribution.json", "documentation.json",
        "host_policy.json", "requirements.txt", "requirements-lock.txt",
        "agents/", "references/", "scripts/", "evals/cases.json"
      ]
    },
    "source": {
      "include": [
        "SKILL.md", "README.md", "distribution.json", "documentation.json",
        "host_policy.json", "requirements.txt", "requirements-lock.txt",
        ".gitignore", ".gitattributes", "agents/", "references/", "scripts/",
        "evals/", "tests/", "tools/", "examples/"
      ]
    }
  },
  "exclude": ["docs/internal/", ".venv/", ".git/", "dist/", "validation/", "runs/"]
}
