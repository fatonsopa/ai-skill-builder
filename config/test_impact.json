  "rules": [
    {
      "paths": [
        "scripts/run_tests.py",
        "config/test_impact.json"
      ],
      "tests": [
        "test-scope"
      ]
    },
    {
      "paths": [
        "scripts/repository_files.py",
        "scripts/repository_layout.py",
        "config/repository_layout.json"
      ],
      "tests": [
        "repository-structure",
        "generation"
      ]
    },
    {
      "paths": [
        "scripts/runtime/artifacts.py",
        "scripts/runtime/contracts.py",
        "assets/*"
      ],
      "tests": [
        "generation"
      ]
    },
    {
      "paths": [
        "scripts/runtime/workflow.py",
        "scripts/runtime/common.py",
        "scripts/skill_builder_cli.py"
      ],
      "tests": [
        "workflow"
      ]
    },
    {
      "paths": [
        "scripts/evaluate.py"
      ],
      "tests": [
        "workflow",
        "generation"
      ]
    },
    {
      "paths": [
        "scripts/runtime/readme.py"
      ],
      "tests": [
        "readme"
      ]
    },
    {
      "paths": [
        "scripts/runtime/adapters.py",
        "scripts/runtime/hosts.py",
        "config/host_policy.json"
      ],
      "tests": [
        "host-adapters"
      ]
    },
    {
      "paths": [
        "scripts/runtime/examples.py",
        "scripts/runtime/benchmark.py",
        "tests/fixtures.py",
        "tests/data/*"
      ],
      "tests": [
        "examples",
        "workflow"
      ]
    },
    {
      "paths": [
        "scripts/install_skill.py",
        "scripts/runtime/delivery.py"
      ],
      "tests": [
        "generation"
      ]
    },
    {
      "paths": [
        "scripts/smoke_check.py"
      ],
      "tests": [
        "smoke"
      ]
    },
    {
      "paths": [
        "tools/check_repository.py"
      ],
      "tests": [
        "test-scope"
      ]
    },
    {
      "paths": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "tests": [
        "instructions"
      ]
    },
    {
      "paths": [
        "README.md",
        "SKILL.md",
        "references/*.md",
        "tests/README.md",
        "agents/*",
        "LICENSE",
        ".gitignore",
        ".gitattributes",
        "scripts/requirements*.txt"
      ],
      "tests": [],
      "reason": "Documentation or metadata: review changed instructions and links; no unrelated behavioral suite."
    },
    {
      "paths": [
        "config/domains.json"
      ],
      "tests": [
        "layout"
      ]
    },
    {
      "paths": [
        "config/documentation.json"
      ],
      "tests": [
        "readme-contract"
      ]
    },
    {
      "paths": [
        "scripts/evaluate.py"
      ],
      "tests": [
        "process-evaluation",
        "behavior-evaluation"
      ]
    },
    {
      "paths": [
        "scripts/runtime/contracts.py",
        "scripts/runtime/artifacts.py",
        "scripts/runtime/workflow.py",
        "scripts/skill_builder_cli.py"
      ],
      "tests": [
        "workflow-coverage",
        "process-evaluation",
        "behavior-evaluation"
      ]
    },
    {
      "paths": [
        "tools/run_behavioral_evals.py"
      ],
      "tests": [
        "behavior-harness"
      ]
    },
    {
      "paths": [
        "evals/cases.json",
        "evals/behavior_rubric.json"
      ],
      "tests": [
        "behavior-evaluation"
      ]
    },
    {
      "paths": [
        "scripts/skill_builder_cli.py"
      ],
      "tests": [
        "cli-output"
      ]
    },
    {
      "paths": [
        "scripts/runtime/workflow.py",
        "scripts/repository_files.py",
        "scripts/runtime/artifacts.py"
      ],
      "tests": [
        "cli-output"
      ]
    },
    {
      "paths": [
        "scripts/runtime/workflow.py",
        "scripts/skill_builder_cli.py"
      ],
      "tests": [
        "replay"
      ]
    },
    {
      "paths": [
        "scripts/continuation.py",
        "scripts/runtime/workflow.py",
        "scripts/runtime/artifacts.py",
        "scripts/runtime/hosts.py",
        "scripts/evaluate.py"
      ],
      "tests": [
        "continuation",
        "retry-integration"
      ]
    },
    {
      "paths": [
        "scripts/runtime/artifacts.py"
      ],
      "tests": [
        "plan-consistency"
      ]
    },
    {
      "paths": [
        "scripts/runtime/workflow.py",
        "scripts/evaluate.py"
      ],
      "tests": [
        "pending-observations"
      ]
    },
    {
      "paths": [
        "scripts/host_coverage.py",
        "config/host_validation.json"
      ],
      "tests": [
        "host-coverage"
      ]
    },
    {
      "paths": [
        "tools/behavior_hosts.py",
        "tools/run_behavioral_evals.py"
      ],
      "tests": [
        "behavior-harness",
        "host-coverage"
      ]
    },
    {
      "paths": [
        "scripts/provider_results.py",
        "scripts/runtime/adapters.py",
        "scripts/runtime/benchmark.py",
        "scripts/host_coverage.py",
        "tools/behavior_hosts.py",
        "tools/run_behavioral_evals.py",
        "tests/test_provider_results.py"
      ],
      "tests": [
        "provider-results"
      ]
    },
    {
      "paths": [
        "scripts/runtime/technical_writer.py",
        "scripts/runtime/workflow.py",
        "scripts/runtime/contracts.py",
        "scripts/runtime/delivery.py",
        "scripts/skill_builder_cli.py",
        "references/technical_writer.md",
        "references/writing_style.md",
        "tests/fixtures.py"
      ],
      "tests": [
        "technical-writer",
        "workflow",
        "generation",
        "cli-output",
        "pending-observations",
        "workflow-coverage",
        "replay"
      ]
    },
    {
      "paths": [
        "scripts/runtime/readme.py"
      ],
      "tests": [
        "technical-writer"
      ]
    },
    {
      "paths": [
        "SKILL.md",
        "references/agents_and_skills.md",
        "references/authoring.md",
        "references/skill_structure.md",
        "config/domains.json",
        "evals/agent_guidance_cases.json",
        "tests/test_agent_guidance.py"
      ],
      "tests": [
